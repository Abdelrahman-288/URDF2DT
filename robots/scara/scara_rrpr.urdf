<?xml version="1.0"?>
<!-- Original idealized RRPR SCARA research fixture; dimensions in metres. -->
<robot name="scara_rrpr">
  <link name="world"/>
  <link name="base">
    <visual><origin xyz="0 0 -0.10"/><geometry><cylinder radius="0.09" length="0.2"/></geometry><material name="base_blue"><color rgba="0.16 0.30 0.48 1"/></material></visual>
  </link>
  <joint name="mount" type="fixed"><parent link="world"/><child link="base"/><origin xyz="0.1 -0.05 0.2" rpy="0 0 0.3"/></joint>
  <link name="upper_arm">
    <visual><origin xyz="0.175 0 0"/><geometry><box size="0.35 0.07 0.055"/></geometry><material name="arm_blue"><color rgba="0.23 0.52 0.82 1"/></material></visual>
  </link>
  <joint name="shoulder" type="revolute"><parent link="base"/><child link="upper_arm"/><axis xyz="0 0 1"/><limit lower="-2.6" upper="2.6" effort="100" velocity="2"/></joint>
  <link name="forearm">
    <visual><origin xyz="0.125 0 0.035"/><geometry><box size="0.25 0.06 0.05"/></geometry><material name="arm_silver"><color rgba="0.72 0.79 0.85 1"/></material></visual>
  </link>
  <joint name="elbow" type="revolute"><parent link="upper_arm"/><child link="forearm"/><origin xyz="0.35 0 0"/><axis xyz="0 0 1"/><limit lower="-2.4" upper="2.4" effort="80" velocity="2"/></joint>
  <link name="carriage">
    <visual><origin xyz="0 0 0.08"/><geometry><cylinder radius="0.025" length="0.36"/></geometry><material name="steel"><color rgba="0.55 0.60 0.65 1"/></material></visual>
  </link>
  <joint name="vertical_slide" type="prismatic"><parent link="forearm"/><child link="carriage"/><origin xyz="0.25 0 0"/><axis xyz="0 0 -1"/><limit lower="0" upper="0.18" effort="100" velocity="0.3"/></joint>
  <link name="wrist">
    <visual><origin xyz="0 0 -0.06"/><geometry><cylinder radius="0.035" length="0.035"/></geometry><material name="wrist_gold"><color rgba="0.94 0.62 0.20 1"/></material></visual>
  </link>
  <joint name="tool_yaw" type="continuous"><parent link="carriage"/><child link="wrist"/><axis xyz="0 0 1"/></joint>
  <link name="tool">
    <visual><origin xyz="0.015 0 -0.02"/><geometry><box size="0.06 0.018 0.04"/></geometry><material name="tool_dark"><color rgba="0.22 0.26 0.31 1"/></material></visual>
  </link>
  <joint name="tool_mount" type="fixed"><parent link="wrist"/><child link="tool"/><origin xyz="0 0 -0.08"/></joint>
</robot>
