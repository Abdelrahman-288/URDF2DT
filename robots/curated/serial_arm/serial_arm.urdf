<?xml version="1.0"?>
<!-- Original URDF2DT teaching geometry. MIT licence; not manufacturer CAD. -->
<robot name="teaching_serial_3r">
  <link name="base">
    <visual>
      <origin xyz="0 0 0.08" />
      <geometry>
        <cylinder radius="0.10" length="0.16" />
      </geometry>
      <material name="dark">
        <color rgba="0.22 0.27 0.33 1" />
      </material>
    </visual>
  </link>
  <link name="arm_1">
    <visual>
      <origin xyz="0.175 0 0" />
      <geometry>
        <box size="0.35 0.065 0.065" />
      </geometry>
      <material name="blue">
        <color rgba="0.18 0.45 0.80 1" />
      </material>
    </visual>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base" />
    <child link="arm_1" />
    <origin xyz="0 0 0.18" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="10" velocity="1" />
  </joint>
  <link name="arm_2">
    <visual>
      <origin xyz="0.14 0 0" />
      <geometry>
        <box size="0.28 0.065 0.065" />
      </geometry>
      <material name="silver">
        <color rgba="0.70 0.77 0.82 1" />
      </material>
    </visual>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="arm_1" />
    <child link="arm_2" />
    <origin xyz="0.35 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="10" velocity="1" />
  </joint>
  <link name="arm_3">
    <visual>
      <origin xyz="0.085 0 0" />
      <geometry>
        <box size="0.17 0.065 0.065" />
      </geometry>
      <material name="orange">
        <color rgba="0.95 0.50 0.12 1" />
      </material>
    </visual>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="arm_2" />
    <child link="arm_3" />
    <origin xyz="0.28 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="10" velocity="1" />
  </joint>
  <link name="tool" />
  <joint name="tool_mount" type="fixed">
    <parent link="arm_3" />
    <child link="tool" />
    <origin xyz=".17 0 0" rpy="0 0 0" />
  </joint>
</robot>